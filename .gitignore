# ---- Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- 构建产物：exe/zip 走 Releases 分发，不进 git
# （单文件 ~95MB，会把每次 clone 拖成 100MB+；release/ 下全是构建输出）
build/
build_rel/
dist/
release/

# ---- 运行时数据（配置 / 翻译缓存 / 自检与基准报告，因人而异）
GameLensData/

# ---- 测试证据图（体积大；真实游戏截图还涉及第三方游戏版权）
tests/assets/**/*.png
tests/assets/**/*.txt

# ---- 语料抽取产物（由游戏资源生成的文本，版权归原游戏）
corpus/
*_corpus*.txt

# ---- 编辑器 / 系统
.idea/
.vscode/
*.swp
Thumbs.db
desktop.ini

# ---- 本项目的工作记录（个人笔记，不对外）
.workbuddy/

# ---- 其它工具的临时目录
perler_*/
.wip/
output/
